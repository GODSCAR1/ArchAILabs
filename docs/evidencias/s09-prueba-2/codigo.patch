+  static Specification<ProductJpaEntity> orderByStock(ProductSearchOrder.Direction direction) {
+    return (root, query, builder) -> {
+      if (query.getResultType() != Long.class && query.getResultType() != long.class) {
+        var stock = root.join(ProductJpaEntity_.stock, JoinType.LEFT);
+        Expression<Integer> available =
+            builder.coalesce(stock.get(CatalogStockJpaEntity_.available), 0);
+        Order stockOrder =
+            direction == ProductSearchOrder.Direction.ASC
+                ? builder.asc(available)
+                : builder.desc(available);
+        query.orderBy(stockOrder, builder.asc(root.get(ProductJpaEntity_.id)));
+      }
+      return null;
+    };
+  }
