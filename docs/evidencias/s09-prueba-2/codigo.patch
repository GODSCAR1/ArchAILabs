+package com.codeja.master_acdc.catalog.infrastructure.adapters.out.persistence;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.codeja.master_acdc.catalog.application.port.ProductSearchUseCase;
+import com.codeja.master_acdc.catalog.domain.model.ProductSearchCriteria;
+import com.codeja.master_acdc.catalog.domain.model.ProductSearchOrder;
+import com.codeja.master_acdc.catalog.domain.model.ProductSearchPage;
+import com.codeja.master_acdc.catalog.domain.model.ProductSearchRow;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.testcontainers.service.connection.ServiceConnection;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.testcontainers.containers.PostgreSQLContainer;
+import org.testcontainers.junit.jupiter.Container;
+import org.testcontainers.junit.jupiter.Testcontainers;
+
+@SpringBootTest
+@Testcontainers
+class ProductSearchStockSortIT {
+
+  private static final UUID CATEGORY_ID = UUID.fromString("00000000-0000-0000-0000-000000000001");
+  private static final List<UUID> ASCENDING_IDS = ids(2, 5, 6, 1, 3, 4);
+  private static final List<UUID> DESCENDING_IDS = ids(4, 1, 3, 2, 5, 6);
+
+  @Container @ServiceConnection
+  static final PostgreSQLContainer<?> POSTGRES = new PostgreSQLContainer<>("postgres:17-alpine");
+
+  @Autowired ProductSearchUseCase productSearchUseCase;
+  @Autowired JdbcTemplate jdbcTemplate;
+
+  @BeforeEach
+  void cleanDatabase() {
+    jdbcTemplate.update("delete from stock");
+    jdbcTemplate.update("delete from products");
+    for (int index = 1; index <= 6; index++) {
+      insertProduct(index);
+    }
+    insertStock(1, 2);
+    insertStock(2, 0);
+    insertStock(3, 2);
+    insertStock(4, 5);
+    insertStock(6, 0);
+  }
+
+  @Test
+  @DisplayName("Ordenación por stock ascendente")
+  void should_order_products_by_stock_ascending_when_stock_sort_is_requested() {
+    assertThat(searchAll(ProductSearchOrder.Direction.ASC))
+        .extracting(ProductSearchRow::id)
+        .containsExactlyElementsOf(ASCENDING_IDS);
+  }
+
+  @Test
+  @DisplayName("Ordenación por stock descendente")
+  void should_order_products_by_stock_descending_when_stock_sort_is_requested() {
+    assertThat(searchAll(ProductSearchOrder.Direction.DESC))
+        .extracting(ProductSearchRow::id)
+        .containsExactlyElementsOf(DESCENDING_IDS);
+  }
+
+  @Test
+  @DisplayName("Producto sin stock ordenado como cero")
+  void should_treat_missing_stock_as_zero_when_sorting_ascending() {
+    List<ProductSearchRow> rows = searchAll(ProductSearchOrder.Direction.ASC);
+
+    assertThat(rows.get(1).id()).isEqualTo(id(5));
+    assertThat(rows.get(1).stock()).isZero();
+  }
+
+  private List<ProductSearchRow> searchAll(ProductSearchOrder.Direction direction) {
+    List<ProductSearchRow> rows = new java.util.ArrayList<>();
+    for (int page = 0; ; page++) {
+      ProductSearchPage result =
+          productSearchUseCase.search(
+              new ProductSearchCriteria(
+                  null,
+                  null,
+                  null,
+                  null,
+                  Set.of(),
+                  false,
+                  page,
+                  2,
+                  new ProductSearchOrder("stock", direction)));
+      rows.addAll(result.content());
+      if (page + 1 >= result.totalPages()) {
+        return rows;
+      }
+    }
+  }
+
+  private void insertProduct(int index) {
+    jdbcTemplate.update(
+        "insert into products (id, name, sku, price, category_id, status, created_at, version) "
+            + "values (?, ?, ?, ?, ?, 'ACTIVE', current_timestamp, 0)",
+        id(index),
+        "Product " + index,
+        "STOCK-" + index,
+        100 + index,
+        CATEGORY_ID);
+  }
+
+  private void insertStock(int index, int available) {
+    jdbcTemplate.update(
+        "insert into stock (product_id, available) values (?, ?)", id(index), available);
+  }
+
+  private static List<UUID> ids(int... values) {
+    return java.util.Arrays.stream(values).mapToObj(ProductSearchStockSortIT::id).toList();
+  }
+
+  private static UUID id(int index) {
+    return UUID.fromString("00000000-0000-0000-0000-00000000000" + index);
+  }
+}
