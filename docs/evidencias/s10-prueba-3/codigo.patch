+package com.codeja.master_acdc.catalog.infrastructure.adapters.out.mongo;
+
+import com.codeja.master_acdc.catalog.domain.model.CategoryProductCount;
+import com.codeja.master_acdc.catalog.domain.port.CategoryProductCountRepository;
+import java.util.List;
+import org.springframework.data.domain.Sort;
+import org.springframework.data.mongodb.core.MongoTemplate;
+import org.springframework.data.mongodb.core.aggregation.Aggregation;
+import org.springframework.data.mongodb.core.aggregation.AggregationResults;
+
+public class CategoryProductCountMongoRepositoryAdapter implements CategoryProductCountRepository {
+
+  private final MongoTemplate mongoTemplate;
+
+  public CategoryProductCountMongoRepositoryAdapter(MongoTemplate mongoTemplate) {
+    this.mongoTemplate = mongoTemplate;
+  }
+
+  @Override
+  public List<CategoryProductCount> findCountsByCategory() {
+    Aggregation aggregation =
+        Aggregation.newAggregation(
+            Aggregation.group("category._id")
+                .first("category.name")
+                .as("categoryName")
+                .count()
+                .as("productCount"),
+            Aggregation.project("categoryName", "productCount").and("_id").as("categoryId"),
+            Aggregation.sort(Sort.Direction.ASC, "categoryName"));
+    AggregationResults<CatalogCategoryProductCountView> results =
+        mongoTemplate.aggregate(
+            aggregation, CatalogProduct.class, CatalogCategoryProductCountView.class);
+    return results.getMappedResults().stream()
+        .map(CatalogCategoryProductCountMongoMapper::toDomain)
+        .toList();
+  }
+}
