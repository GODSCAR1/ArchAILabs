+package com.codeja.master_acdc.catalog.infrastructure.adapters.out.mongo;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.codeja.master_acdc.catalog.domain.model.ProductStatus;
+import com.mongodb.ConnectionString;
+import com.mongodb.MongoClientSettings;
+import com.mongodb.client.MongoClient;
+import com.mongodb.client.MongoClients;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.bson.UuidRepresentation;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.springframework.data.mongodb.core.MongoTemplate;
+import org.testcontainers.junit.jupiter.Container;
+import org.testcontainers.junit.jupiter.Testcontainers;
+import org.testcontainers.mongodb.MongoDBContainer;
+import org.testcontainers.utility.DockerImageName;
+
+@Testcontainers
+class CategoryProductCountMongoRepositoryAdapterTest {
+
+  @Container
+  static final MongoDBContainer MONGO = new MongoDBContainer(DockerImageName.parse("mongo:7.0"));
+
+  private static MongoClient client;
+  private static MongoTemplate template;
+  private CategoryProductCountMongoRepositoryAdapter adapter;
+
+  @BeforeAll
+  static void initialize_mongo_template() {
+    client =
+        MongoClients.create(
+            MongoClientSettings.builder()
+                .applyConnectionString(new ConnectionString(MONGO.getReplicaSetUrl()))
+                .uuidRepresentation(UuidRepresentation.STANDARD)
+                .build());
+    template = new MongoTemplate(client, "category_product_count_test");
+  }
+
+  @AfterAll
+  static void close_mongo_client() {
+    client.close();
+  }
+
+  @BeforeEach
+  void initialize_adapter() {
+    template.getDb().drop();
+    adapter = new CategoryProductCountMongoRepositoryAdapter(template);
+  }
+
+  @Test
+  @DisplayName("Consulta de conteos por categoría")
+  void should_count_products_per_category_when_products_have_different_statuses() {
+    UUID categoryA = UUID.randomUUID();
+    UUID categoryB = UUID.randomUUID();
+    template.insertAll(
+        List.of(
+            product("A1", categoryA, "Audio", ProductStatus.ACTIVE),
+            product("A2", categoryA, "Audio", ProductStatus.DRAFT),
+            product("A3", categoryA, "Audio", ProductStatus.DISCONTINUED),
+            product("B1", categoryB, "Books", ProductStatus.ACTIVE)));
+
+    var counts = adapter.findCountsByCategory();
+
+    assertThat(counts)
+        .extracting(
+            count -> count.categoryId() + ":" + count.categoryName() + ":" + count.productCount())
+        .containsExactly(categoryA + ":Audio:3", categoryB + ":Books:1");
+  }
+
+  @Test
+  @DisplayName("Catálogo vacío")
+  void should_return_no_category_counts_when_catalog_is_empty() {
+    assertThat(adapter.findCountsByCategory()).isEmpty();
+  }
+
+  private CatalogProduct product(
+      String sku, UUID categoryId, String categoryName, ProductStatus status) {
+    return new CatalogProduct(
+        UUID.randomUUID(),
+        sku,
+        "Product " + sku,
+        100,
+        status,
+        Instant.parse("2026-01-01T00:00:00Z"),
+        0,
+        new CategoryRef(categoryId, categoryName),
+        List.of(),
+        Map.of(),
+        0,
+        new RatingSummary(BigDecimal.ZERO.setScale(2), 0),
+        List.of());
+  }
+}
