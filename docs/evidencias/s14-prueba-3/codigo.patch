@@ -0,0 +1,33 @@
+package com.codeja.master_acdc.identity.infrastructure.adapters.out.security;
+
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.util.stream.Stream;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+
+class JwtSettingsTest {
+  @ParameterizedTest
+  @MethodSource("invalidSettings")
+  @DisplayName("Configuración JWT incompleta o sin resolver se rechaza")
+  void should_reject_settings_when_required_values_are_invalid(
+      String key, String issuer, String audience, String expectedMessage) {
+    assertThatThrownBy(() -> new JwtSettings(key, issuer, audience))
+        .isInstanceOf(IllegalArgumentException.class)
+        .hasMessageContaining(expectedMessage);
+  }
+
+  private static Stream<Arguments> invalidSettings() {
+    return Stream.of(
+        Arguments.of(null, "https://example.com", "api", "Missing or invalid JWT settings"),
+        Arguments.of(" ", "https://example.com", "api", "Missing or invalid JWT settings"),
+        Arguments.of("key", "https://example.com", null, "Missing or invalid JWT settings"),
+        Arguments.of("key", "https://example.com", " ", "Missing or invalid JWT settings"),
+        Arguments.of("key", null, "api", "Missing or invalid JWT settings"),
+        Arguments.of("key", "https://example.com/${ISSUER}", "api", "Illegal character"),
+        Arguments.of(
+            "key", "https://example.com", "${AUDIENCE}", "Missing or invalid JWT settings"));
+  }
+}
