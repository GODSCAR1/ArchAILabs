--- /dev/null
+++ b/src/test/java/com/codeja/master_acdc/identity/infrastructure/adapters/out/security/PemKeyLoaderTest.java
@@ -0,0 +1,47 @@
+package com.codeja.master_acdc.identity.infrastructure.adapters.out.security;
+
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.KeyPairGenerator;
+import java.security.NoSuchAlgorithmException;
+import java.util.Base64;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class PemKeyLoaderTest {
+  @TempDir Path directory;
+
+  @Test
+  @DisplayName("PEM sin cierre PKCS8 se rechaza")
+  void should_reject_key_when_pem_footer_is_missing() throws IOException {
+    Path path = directory.resolve("key.pem");
+    Files.writeString(
+        path, pem("invalid").lines().limit(2).collect(java.util.stream.Collectors.joining("\n")));
+    assertThatThrownBy(() -> PemKeyLoader.load(path.toString()))
+        .isInstanceOf(IllegalArgumentException.class)
+        .hasMessage("Expected PKCS8 private PEM");
+  }
+
+  @Test
+  @DisplayName("Clave RSA de tamaño distinto a 2048 se rechaza")
+  void should_reject_key_when_rsa_modulus_is_not_2048_bits()
+      throws IOException, NoSuchAlgorithmException {
+    var generator = KeyPairGenerator.getInstance("RSA");
+    generator.initialize(1024);
+    String body =
+        Base64.getEncoder().encodeToString(generator.generateKeyPair().getPrivate().getEncoded());
+    Path path = directory.resolve("key.pem");
+    Files.writeString(path, pem(body));
+    assertThatThrownBy(() -> PemKeyLoader.load(path.toString()))
+        .isInstanceOf(IllegalArgumentException.class)
+        .hasMessage("Expected RSA CRT 2048 key");
+  }
+
+  private static String pem(String body) {
+    return "[PEM-BEGIN]\n" + body + "\n[PEM-END]";
+  }
+}
